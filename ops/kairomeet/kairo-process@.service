[Unit]
Description=KairoMeet - cola persistente %i
After=network-online.target
Wants=network-online.target

[Service]
User=kairo
WorkingDirectory=/opt/kairomeet
Environment=XDG_RUNTIME_DIR=/run/kairo
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/kairomeet/venv/bin/python /opt/kairomeet/processor.py --stage %i
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
